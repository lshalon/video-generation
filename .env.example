# API Keys for video generation services
# Copy this file to .env and fill in your keys

# OpenAI API key (for GPT models and DALL-E)
OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Kling API keys (for Kling video generation)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Fal API key (for Fal.ai models)
FAL_KEY=
